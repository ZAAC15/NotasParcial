{
  "expo": {
    "name": "Notas al día",
    "slug": "notas-al-dia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "notasaldia",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scoll.notasaldia",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Notas al día usa el micrófono para grabar notas de voz."
      }
    },
    "android": {
      "package": "com.scoll.notasaldia",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F3EBDD"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una foto para adjuntarla a tus notas.",
          "cameraPermission": "Permite tomar fotos para tus notas.",
          "microphonePermission": "Permite grabar notas de voz."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permite grabar notas de voz.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dac5e922-56a3-4f21-bec2-f2c31f4e037f"
      }
    }
  }
}
